<Window x:Class="PushBox.Windows.Views.FirstLaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PushBox.Windows.Controls"
        Title="接入 PushBox"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource Bg.Page}"
        FontFamily="{DynamicResource Font.UI}">
    <Window.Resources>
        <!-- 字段标签：13px 次级色 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- 辅助说明：12px 次级色、可换行。行高必须跟着 12 那一档（16），
             原来写的是 18（Small 的行高），字号与行距对不上 -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.LabelSize}" />
            <Setter Property="LineHeight" Value="{x:Static controls:MarkdownStyle.LabelLine}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 输入框：灰底圆角井，聚焦描 accent。字号走正文 15：原来写 14 不在六档里 -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.BodySize}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{DynamicResource Bg.Elevated}"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,6"
                                          VerticalContentAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fg.Secondary}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮：accent 实底 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource Accent}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次按钮：描边空心，悬停铺灰 -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Elevated}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 复选框：圆角小方井，勾选填 accent 打白勾 -->
        <Style x:Key="AccentCheck" TargetType="CheckBox">
            <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Border x:Name="Box" Background="{DynamicResource Bg.Elevated}"
                                        BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                                        CornerRadius="4" SnapsToDevicePixels="True" />
                                <Path x:Name="Check" Data="M3.5,8 L6.5,11 L12.5,4.5"
                                      Stroke="{DynamicResource OnAccent}"
                                      StrokeThickness="2" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 忙指示：4px 圆角轨道 + 一段 accent 来回扫 -->
        <Style x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{DynamicResource Bg.Elevated}" CornerRadius="2" />
                            <Border x:Name="Indicator" Width="48" HorizontalAlignment="Left"
                                    CornerRadius="2" Background="{DynamicResource Accent}">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="Shift" X="-48" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="Ind">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Shift"
                                                             Storyboard.TargetProperty="X"
                                                             From="-48" To="120" Duration="0:0:0.9" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Ind" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="32,26,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 抬头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Style="{DynamicResource Text.H1}" Foreground="{DynamicResource Fg.Primary}"
                       Text="接入 PushBox" />
            <TextBlock Style="{DynamicResource Text.Small}" Foreground="{DynamicResource Fg.Secondary}"
                       TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="这是这台电脑第一次连接 PushBox。密钥在本机生成，私钥不会离开这台电脑；服务器只知道它的公钥。" />
        </StackPanel>

        <!-- 第 1 屏：注册 / 加入 -->
        <StackPanel x:Name="EnrollPanel" Grid.Row="1">
            <TextBlock Style="{StaticResource FieldLabel}" Text="服务器主机 / IP" />
            <TextBox x:Name="ServerHostBox" Style="{StaticResource FieldBox}" Margin="0,0,0,14"
                     ToolTip="例如 push.example.com 或 192.168.1.10" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="端口" />
            <TextBox x:Name="ServerPortBox" Style="{StaticResource FieldBox}" Margin="0,0,0,14"
                     HorizontalAlignment="Left" Width="120" Text="7404"
                     ToolTip="默认 7404，留空使用默认端口" />

            <CheckBox x:Name="UseHttpsCheckbox" Style="{StaticResource AccentCheck}"
                      Content="使用 HTTPS（SSL/TLS）" Margin="0,0,0,10" />
            <TextBlock x:Name="GeneratedUrlBox" Style="{DynamicResource Text.Code}"
                       Foreground="{DynamicResource Fg.Secondary}" TextWrapping="Wrap"
                       Margin="0,0,0,14" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="设备名称（在手机的设备列表里会看到它）" />
            <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" Margin="0,0,0,18" />

            <StackPanel x:Name="RecoveryPanel" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="恢复码" />
                <TextBox x:Name="CodeBox" Style="{StaticResource FieldBox}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,14"
                           Text="在手机的「设置 → 设备信息」里能看到恢复码和二维码。加入之后这里不会再次显示它。" />
                <Button x:Name="JoinConfirmButton" Style="{StaticResource PrimaryButton}"
                        Content="加入" HorizontalAlignment="Left" Click="OnJoinConfirmClick" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button x:Name="CreateButton" Style="{StaticResource PrimaryButton}"
                        Content="创建新的个人空间" Click="OnCreateClick" />
                <Button x:Name="JoinButton" Style="{StaticResource SecondaryButton}"
                        Content="我有恢复码，加入已有空间" Margin="10,0,0,0" Click="OnJoinClick" />
            </StackPanel>
        </StackPanel>

        <!-- 第 2 屏：新空间的恢复码只在这里出现一次 -->
        <StackPanel x:Name="BackupPanel" Grid.Row="1" Visibility="Collapsed">
            <TextBlock Style="{DynamicResource Text.H2}" Foreground="{DynamicResource Fg.Primary}"
                       Text="请抄下这台空间的恢复码" />
            <TextBlock Style="{DynamicResource Text.Small}" Foreground="{DynamicResource Fg.Secondary}"
                       TextWrapping="Wrap" Margin="0,6,0,16"
                       Text="它是唯一的「账号」：换机、加第二台设备都靠它。服务端只存它的哈希，所以丢了没法找回。" />
            <TextBox x:Name="CodeShowBox" IsReadOnly="True" Style="{StaticResource FieldBox}"
                     FontFamily="{DynamicResource Font.Code}" FontSize="{x:Static controls:MarkdownStyle.H2Size}" TextAlignment="Center"
                     MinHeight="48" Margin="0,0,0,10" />
            <TextBlock Style="{StaticResource HintText}" Foreground="{DynamicResource Level.Error}"
                       Margin="0,0,0,16" Text="抄好之前不要退出。下一次只有已登录的设备能重新导出它。" />
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Content="复制到剪贴板" Click="OnCopyCodeClick" />
                <Button x:Name="EnterButton" Style="{StaticResource PrimaryButton}"
                        Content="我已抄好，进入" Margin="10,0,0,0" Click="OnEnterClick" />
            </StackPanel>
        </StackPanel>

        <!-- 报错：灰底卡片 + 3px 红色左竖条 -->
        <Border Grid.Row="2" Margin="0,16,0,0" Background="{DynamicResource Bg.Elevated}"
                CornerRadius="6" Padding="12,10"
                Visibility="{Binding Visibility, ElementName=ErrorBox}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource Level.Error}"
                        CornerRadius="1.5" Margin="0,2,10,2" />
                <TextBlock x:Name="ErrorBox" Grid.Column="1" Style="{DynamicResource Text.Small}"
                           Foreground="{DynamicResource Level.Error}" TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- 忙状态 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
            <ProgressBar x:Name="BusyBar" Style="{StaticResource ThinProgress}" Width="120"
                         Visibility="Collapsed" IsIndeterminate="True" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusBox" Style="{DynamicResource Text.Small}"
                       Foreground="{DynamicResource Fg.Secondary}" Margin="10,0,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
