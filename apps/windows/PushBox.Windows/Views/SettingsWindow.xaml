<Window x:Class="PushBox.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PushBox.Windows.Controls"
        Title="PushBox 设置" Width="900" Height="640" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg.Page}"
        FontFamily="{DynamicResource Font.UI}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <!-- §8.4 W16：PC 端的控制台，把 Android 的 ChannelsTab / DeviceRow / SettingsTab 对齐过来。
         左边一列窄导航、右边一屏内容（微信 PC 设置那一屏的形状），三块面板叠在同一格靠 Visibility 切换。
         这里只放控件与文案：留空算不算提交、按钮该不该出现在这一行、这段话怎么说，全在 SettingsModel。 -->
    <Window.Resources>
        <!-- 导航项样式：增加圆角、过渡效果与键盘焦点框（Tab 到哪一项要看得见） -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
            <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Visual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shell" Background="Transparent" Padding="16,12" Cursor="Hand"
                                CornerRadius="8" Margin="8,2">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Bg.Page}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shell" Property="Background"
                                        Value="{DynamicResource Bg.AccentTint}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 字段标签样式 -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
        </Style>
        
        <!-- 输入框：圆角 + 主题底色，hover 深描边、聚焦 accent 描边、禁用减淡。
             不给模板的话深色模式下这里是一片系统白底、字却是浅灰的；默认模板的
             hover/焦点描边也全是系统浅蓝，与两套色板都对不上 -->
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{DynamicResource Bg.Page}"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                                CornerRadius="4" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Fg.Secondary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 下拉框：表面与输入框同一套。默认模板的下拉弹层在深色下仍是系统白底，
             这里连弹层与选项高亮一起换 token -->
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Shell" Background="{DynamicResource Bg.Page}"
                                    BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                                    CornerRadius="4" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                    <Path Grid.Column="1" Data="M0,0 L4,4 8,0"
                                          Stroke="{DynamicResource Fg.Secondary}" StrokeThickness="1.5"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="Toggle" Focusable="False" IsTabStop="False"
                                          Background="Transparent" BorderThickness="0" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                                   AllowsTransparency="True" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource Bg.Elevated}"
                                        BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                                        CornerRadius="4" Margin="0,2,0,0" Padding="2"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Fg.Secondary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉选项：悬停/选中铺浅绿底，选中加粗 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Shell" Background="Transparent" CornerRadius="4" Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Shell" Property="Background"
                                        Value="{DynamicResource Bg.AccentTint}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 列表：默认模板是白底 + 系统蓝选中条，深色下整块发白、选中也还是蓝的。
             条目做成"页面上的卡片"（item 自带 Bg.Elevated 底、hover 抬起、选中铺浅绿），
             列表本身只留外框与滚动——频道与设备两处共用这一份，条目模板只管内容 -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="4" SnapsToDevicePixels="True">
                            <ScrollViewer Focusable="False" Padding="0"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Visual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Shell" Background="{DynamicResource Bg.Elevated}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Btn.Ghost.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Bg.AccentTint}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 按钮不再用这一窗自己的隐式样式：五个 Button.* 键在两份 token 字典里（§9.4），
             三态与换肤都在那边，这里每个按钮显式挂 Style -->
        
        <!-- 卡片样式 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource Bg.Elevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        
        <!-- Section 标题与说明直接用 §9.2 的 Text.* 档位，不在这一页另立一套字号 -->
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="132" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Bg.Elevated}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,16,0,16">
                <!-- 标题 -->
                <TextBlock Text="设置" Style="{DynamicResource Text.H2}"
                           Foreground="{DynamicResource Fg.Primary}"
                           Margin="16,0,16,16"/>
                
                <RadioButton x:Name="NavChannels" Content="频道" GroupName="nav" IsChecked="True" Tag="channels"
                             ToolTip="Alt+1" Style="{StaticResource NavItemStyle}" Checked="OnNavChanged" />
                <RadioButton x:Name="NavDevices" Content="设备" GroupName="nav" Tag="devices"
                             ToolTip="Alt+2" Style="{StaticResource NavItemStyle}" Checked="OnNavChanged" />
                <RadioButton x:Name="NavNotify" Content="通知与外观" GroupName="nav" Tag="notify"
                             ToolTip="Alt+3" Style="{StaticResource NavItemStyle}" Checked="OnNavChanged" />
                <RadioButton x:Name="NavAbout" Content="关于与更新" GroupName="nav" Tag="about"
                             ToolTip="Alt+4" Style="{StaticResource NavItemStyle}" Checked="OnNavChanged" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24,20">
            <ScrollViewer x:Name="ChannelsPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 新建频道 Section -->
                    <TextBlock Text="新建频道" Style="{DynamicResource Text.H3}"
                               Foreground="{DynamicResource Fg.Primary}" Margin="0,16,0,8" />
                    <TextBlock Text="创建一个新频道来接收消息，名称留空则使用设备名"
                               Style="{DynamicResource Text.Label}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Fg.Secondary}" Margin="0,4,0,0"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBox x:Name="NewChannelName" Width="280" />
                        <Button Content="新建频道" Margin="10,0,0,0" Click="OnCreateChannel"
                                Style="{DynamicResource Button.Primary}" />
                        <Button Content="刷新列表" Margin="10,0,0,0" Click="OnReloadChannels"
                                Style="{DynamicResource Button.Accent}" />
                    </StackPanel>

                    <!-- 接入信息卡片 -->
                    <Border x:Name="IssuedCard" Visibility="Collapsed" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.H3}" Foreground="{DynamicResource Accent}">
                                <Run FontFamily="{DynamicResource Font.Icon}" Text="&#xE73E;" /><Run Text=" 接入信息（密钥只显示这一次）" />
                            </TextBlock>
                                    <TextBlock x:Name="IssuedNo" Style="{DynamicResource Text.Code}" Margin="0,10,0,0"
                                       Foreground="{DynamicResource Fg.Primary}" />
                            <TextBlock x:Name="IssuedSecret" Style="{DynamicResource Text.Code}" Margin="0,6,0,0"
                                       Foreground="{DynamicResource Fg.Primary}" />
                            <TextBlock x:Name="IssuedCurl" Style="{DynamicResource Text.Label}" Margin="0,8,0,0"
                                       TextWrapping="Wrap" FontFamily="{DynamicResource Font.Code}"
                                       Foreground="{DynamicResource Fg.Secondary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="复制频道号" Click="OnCopyChannelNo"
                                        Style="{DynamicResource Button.Primary}" />
                                <Button Content="复制密钥" Margin="10,0,0,0" Click="OnCopySecret"
                                        Style="{DynamicResource Button.Primary}" />
                                <Button Content="复制 curl" Margin="10,0,0,0" Click="OnCopyCurl"
                                        Style="{DynamicResource Button.Primary}" />
                                <Button Content="收起来" Margin="10,0,0,0" Click="OnDismissIssued"
                                        Style="{DynamicResource Button.Secondary}" />
                            </StackPanel>
                            <TextBlock Style="{DynamicResource Text.Label}" Margin="0,10,0,0"
                                       Foreground="{DynamicResource Level.Error}">
                                <Run FontFamily="{DynamicResource Font.Icon}" Text="&#xE7BA;" /><Run Text=" 密钥只显示这一次，请立即复制保存。" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 加入频道 Section -->
                    <TextBlock Text="加入频道" Style="{DynamicResource Text.H3}"
                               Foreground="{DynamicResource Fg.Primary}" Margin="0,16,0,8" />
                    <TextBlock Style="{DynamicResource Text.Label}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="填别人给你的频道号与密钥即可接收该频道的消息。密钥只用来确认号码写对了，它不是读取凭据；跨 Space 的频道号服务端一律回 404。"
                               Foreground="{DynamicResource Fg.Secondary}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBox x:Name="JoinNo" Width="140" />
                        <TextBox x:Name="JoinSecret" Width="240" Margin="10,0,0,0" />
                        <Button Content="加入" Margin="10,0,0,0" Click="OnJoinChannel"
                                Style="{DynamicResource Button.Primary}" />
                        <Button Content="用选中频道号" Margin="10,0,0,0" Click="OnUseSelectedNo"
                                Style="{DynamicResource Button.Accent}" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <CheckBox x:Name="FilterOnly" Content="只接收已接入的频道" FontSize="{x:Static controls:MarkdownStyle.SmallSize}"
                                  Foreground="{DynamicResource Fg.Primary}"
                                  Checked="OnToggleFilterOnly" Unchecked="OnToggleFilterOnly" />
                        <TextBlock x:Name="FilterOnlyLabel" Style="{DynamicResource Text.Label}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" Text="未开启"
                                   Foreground="{DynamicResource Fg.Secondary}" />
                    </StackPanel>
                    <TextBlock Text="开启后这台电脑只收已接入频道的消息；其余频道仍在服务器上好着，只是这台不弹。关掉即恢复全收，接入关系不会丢。"
                               Style="{DynamicResource Text.Label}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Fg.Secondary}" />
                    <TextBlock x:Name="FilterWarning" Style="{DynamicResource Text.Label}" Margin="0,6,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource Level.Error}" />

                    <TextBlock x:Name="ChannelNotice" Style="{DynamicResource Text.Label}" Margin="0,12,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource Level.Error}" />

                    <!-- 我的频道列表 -->
                    <TextBlock Text="我的频道" Style="{DynamicResource Text.H3}"
                               Foreground="{DynamicResource Fg.Primary}" Margin="0,16,0,8" />
                    <ListBox x:Name="ChannelList" Height="160" Margin="0,10,0,0"
                             SelectionChanged="OnChannelSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 卡片的底、内边距与选中态都在 ListBoxItem 那份隐式样式里，这里只管内容 -->
                                <StackPanel>
                                    <TextBlock Text="{Binding TitleText}" Style="{DynamicResource Text.Small}"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource Fg.Primary}" />
                                    <TextBlock Text="{Binding ChannelNo}" Style="{DynamicResource Text.Label}"
                                               FontFamily="{DynamicResource Font.Code}"
                                               Foreground="{DynamicResource Fg.Secondary}" />
                                    <TextBlock Text="{Binding SummaryText}" Style="{DynamicResource Text.Label}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Fg.Secondary}" />
                                    <!-- 接入状态是本机这一台的事，另一台设备上同一张列表可以全是"未接入" -->
                                    <TextBlock Text="{Binding SubscriptionBadge}" Style="{DynamicResource Text.Label}"
                                               Foreground="{DynamicResource Level.Highlight}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ChannelEmpty" Style="{DynamicResource Text.Small}" Margin="0,10,0,0"
                               Visibility="Collapsed"
                               Text="还没有频道，点上方「新建频道」创建，或用频道号+密钥「加入频道」"
                               Foreground="{DynamicResource Fg.Secondary}" />

                    <!-- 选中一条才出现：治理位、白名单、容量都在"这一条频道"的作用域里 -->
                    <Border x:Name="GovernanceCard" Visibility="Collapsed" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="频道治理" Style="{DynamicResource Text.H3}"
                                       Foreground="{DynamicResource Fg.Primary}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="38" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="频道名称"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="GovName" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="提醒强度上限" Margin="20,0,12,0"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox Grid.Row="0" Grid.Column="3" x:Name="GovLevel" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="单次最多图片数"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="GovMaxImages" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="每分钟条数上限" Margin="20,0,12,0"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="3" x:Name="GovRateLimit" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="单条正文最大字节"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="GovBodyBytes" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="每日条数上限" Margin="20,0,12,0"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Grid.Row="2" Grid.Column="3" x:Name="GovDailyMsg" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="每日图片上限"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="GovDailyImage" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="每日字节上限" Margin="20,0,12,0"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Grid.Row="3" Grid.Column="3" x:Name="GovDailyBytes" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <CheckBox x:Name="GovStrict" Content="强制校验 sender" FontSize="{x:Static controls:MarkdownStyle.SmallSize}"
                                          Foreground="{DynamicResource Fg.Primary}" />
                                <CheckBox x:Name="GovMuted" Content="频道静默（不再弹通知）" FontSize="{x:Static controls:MarkdownStyle.SmallSize}"
                                          Margin="20,0,0,0" Foreground="{DynamicResource Fg.Primary}" />
                                <CheckBox x:Name="GovWhitelist" Content="只允许白名单发送者" FontSize="{x:Static controls:MarkdownStyle.SmallSize}"
                                          Margin="20,0,0,0" Foreground="{DynamicResource Fg.Primary}" />
                            </StackPanel>
                            <TextBlock Text="填 0 表示沿用服务端默认值；留空表示这一项不动。"
                                       Style="{DynamicResource Text.Label}"
                                       Margin="0,8,0,0" Foreground="{DynamicResource Fg.Secondary}" />
                            <TextBlock x:Name="GovSubscriptionLine" Style="{DynamicResource Text.Label}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Fg.Secondary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="保存" Click="OnSaveGovernance"
                                        Style="{DynamicResource Button.Primary}" />
                                <Button Content="发送者白名单" Margin="10,0,0,0" Click="OnOpenSenders"
                                        Style="{DynamicResource Button.Secondary}" />
                                <Button Content="容量报表" Margin="10,0,0,0" Click="OnCapacity"
                                        Style="{DynamicResource Button.Secondary}" />
                            </StackPanel>

                            <!-- 危险操作独立分组：红色描边钮混在一排常规操作里等于没分区。
                                 每一项带一句 13px 副标题，让"点了会发生什么"在点之前就读得到——
                                 确认框还在，这只是提前一步的预告，两处文案同源（SettingsModel） -->
                            <Border Margin="0,16,0,0" Padding="14" CornerRadius="8"
                                    BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                                    Background="{DynamicResource Bg.Page}">
                                <StackPanel>
                                    <TextBlock Text="危险操作" Style="{DynamicResource Text.H3}"
                                               Foreground="{DynamicResource Fg.Primary}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Grid.Column="0" Width="140" Margin="0,5"
                                                Content="重置密钥" Click="OnRotateSecret"
                                                Style="{DynamicResource Button.Danger}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{DynamicResource Text.Small}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Text="旧密钥即刻失效，发消息的第三方要改用新密钥。"
                                                   Foreground="{DynamicResource Fg.Secondary}" />
                                        <Button Grid.Row="1" Grid.Column="0" Width="140" Margin="0,5"
                                                Content="换发新频道号" Click="OnResetChannelNo"
                                                Style="{DynamicResource Button.Danger}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{DynamicResource Text.Small}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Text="旧号码即刻作废，第三方要改投递地址；历史消息随迁。"
                                                   Foreground="{DynamicResource Fg.Secondary}" />
                                        <Button Grid.Row="2" Grid.Column="0" Width="140" Margin="0,5"
                                                Content="清空" Click="OnClearChannel"
                                                Style="{DynamicResource Button.Danger}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{DynamicResource Text.Small}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Text="删除全部历史消息与图片（各端同步）；频道与地址保留。"
                                                   Foreground="{DynamicResource Fg.Secondary}" />
                                        <!-- 取消接入不需要密钥（这台设备本来就接进来过），所以它留在治理区而不是上面那格表单里；
                                             副标题跟按钮同进退：按钮藏起来的行，说明也不能留在原地 -->
                                        <Button Grid.Row="3" Grid.Column="0" x:Name="LeaveButton" Width="140" Margin="0,5"
                                                Content="取消接入" Visibility="Collapsed" Click="OnLeaveChannel"
                                                Style="{DynamicResource Button.Danger}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LeaveHint"
                                                   Style="{DynamicResource Text.Small}" Visibility="Collapsed"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Text="这台电脑不再接收该频道；重新加入即可恢复。"
                                                   Foreground="{DynamicResource Fg.Secondary}" />
                                        <Button Grid.Row="4" Grid.Column="0" Width="140" Margin="0,5"
                                                Content="归档" Click="OnArchiveChannel"
                                                Style="{DynamicResource Button.Danger}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{DynamicResource Text.Small}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Text="归档后拒收新消息，历史消息保留；不可恢复。"
                                                   Foreground="{DynamicResource Fg.Secondary}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 白名单就地展开：它只管这一条频道，弹一层窗口只会让人找不到刚点了什么 -->
                            <Border x:Name="SendersCard" Visibility="Collapsed" Margin="0,16,0,0" Padding="14"
                                    CornerRadius="8" BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                                    Background="{DynamicResource Bg.Page}">
                                <StackPanel>
                                    <TextBlock Text="白名单发送者" Style="{DynamicResource Text.H3}"
                                               Foreground="{DynamicResource Fg.Primary}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBox x:Name="SenderIdInput" Width="240" />
                                        <Button Content="添加" Margin="10,0,0,0" Click="OnAddSender"
                                                Style="{DynamicResource Button.Primary}" />
                                    </StackPanel>
                                    <TextBlock x:Name="SendersHint" Style="{DynamicResource Text.Label}" Margin="0,8,0,0"
                                               TextWrapping="Wrap" Foreground="{DynamicResource Level.Error}" />
                                    <ItemsControl x:Name="SenderList" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="10,8" Margin="0,3" CornerRadius="6"
                                                        Background="{DynamicResource Bg.Elevated}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding SenderId}" Style="{DynamicResource Text.Code}"
                                                                   Width="240" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource Fg.Primary}" />
                                                        <TextBlock Text="{Binding StatusText}" Style="{DynamicResource Text.Label}"
                                                                   Width="80" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Fg.Secondary}" />
                                                        <!-- Tag 交的是这一行那个对象本身：停用与启用是同一个动作的两个方向 -->
                                                        <Button Content="切换状态" Tag="{Binding}" Height="28"
                                                                Padding="12,0" Click="OnSenderToggle"
                                                                Style="{DynamicResource Button.Accent}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="DevicesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="设备" Style="{DynamicResource Text.H3}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Fg.Primary}" />
                        <Button Content="刷新" Margin="12,0,0,0" Click="OnReloadDevices"
                                Style="{DynamicResource Button.Secondary}" />
                    </StackPanel>
                    <TextBlock x:Name="DeviceNotice" Style="{DynamicResource Text.Label}" Margin="0,8,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource Level.Error}" />
                    <ListBox x:Name="DeviceList" Height="220" Margin="0,8,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Style="{DynamicResource Text.Small}" Width="170"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Fg.Primary}" />
                                    <TextBlock Text="{Binding DeviceId}" Style="{DynamicResource Text.Label}" Width="190"
                                               FontFamily="{DynamicResource Font.Code}"
                                               Foreground="{DynamicResource Fg.Secondary}" />
                                    <TextBlock Text="{Binding Platform}" Style="{DynamicResource Text.Label}" Width="80"
                                               Foreground="{DynamicResource Fg.Secondary}" />
                                    <TextBlock Text="{Binding LastSeenText}" Style="{DynamicResource Text.Label}" Width="80"
                                               Foreground="{DynamicResource Fg.Secondary}" />
                                    <TextBlock Text="{Binding StatusText}" Style="{DynamicResource Text.Label}"
                                               Foreground="{DynamicResource Accent}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="DeviceEmpty" Style="{DynamicResource Text.Small}" Margin="0,8,0,0"
                               Visibility="Collapsed"
                               Text="没有其他设备" Foreground="{DynamicResource Fg.Secondary}" />

                    <TextBlock Text="恢复码" Style="{DynamicResource Text.H3}" Margin="0,22,0,0"
                               Foreground="{DynamicResource Fg.Primary}" />
                    <TextBlock x:Name="RecoveryText" Style="{DynamicResource Text.Code}" Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Fg.Primary}" />
                    <TextBlock Text="它是找回全部历史与设备的唯一凭据，泄露等于任何人可读你的消息。"
                               Style="{DynamicResource Text.Label}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Fg.Secondary}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="复制" Click="OnCopyRecovery"
                                Style="{DynamicResource Button.Secondary}" />
                    </StackPanel>
                    <TextBlock x:Name="RecoveryHint" Style="{DynamicResource Text.Label}" Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" Foreground="{DynamicResource Level.Error}" />

                    <!-- 危险操作独立分组：与频道面板同一套形状（灰底卡 + 每项一句 13px 副标题），
                         吊销/轮换/退出都从原来的散落位置收进来，确认框文案与副标题同源 -->
                    <Border Margin="0,22,0,0" Padding="14" CornerRadius="8"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                            Background="{DynamicResource Bg.Page}">
                        <StackPanel>
                            <TextBlock Text="危险操作" Style="{DynamicResource Text.H3}"
                                       Foreground="{DynamicResource Fg.Primary}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Grid.Column="0" Width="160" Margin="0,5"
                                        Content="吊销这台" Click="OnRevokeDevice"
                                        Style="{DynamicResource Button.Danger}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{DynamicResource Text.Small}"
                                           Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="令牌立即失效并强制下线，需凭恢复码重新加入。"
                                           Foreground="{DynamicResource Fg.Secondary}" />
                                <Button Grid.Row="1" Grid.Column="0" Width="160" Margin="0,5"
                                        Content="轮换恢复码" Click="OnRotateRecovery"
                                        Style="{DynamicResource Button.Danger}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{DynamicResource Text.Small}"
                                           Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="旧码即刻失效，已登录设备不受影响；新码只显示这一次。"
                                           Foreground="{DynamicResource Fg.Secondary}" />
                                <!-- §7.3 退出空间：清空所有数据回到首启，与 Android "更换服务器"同效 -->
                                <Button Grid.Row="2" Grid.Column="0" Width="160" Margin="0,5"
                                        Content="退出空间（清空数据）" Click="OnLogout"
                                        Style="{DynamicResource Button.Danger}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{DynamicResource Text.Small}"
                                           Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="清空本机全部会话、消息、图片与身份，回到首启注册页；本机的恢复码也会一并清掉。"
                                           Foreground="{DynamicResource Fg.Secondary}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="NotifyPanel" Visibility="Collapsed">
                <TextBlock Text="通知" Style="{DynamicResource Text.H3}" Foreground="{DynamicResource Fg.Primary}" />
                <CheckBox x:Name="NotifyOn" Content="新消息通知" FontSize="{x:Static controls:MarkdownStyle.SmallSize}" Margin="0,14,0,0"
                          Foreground="{DynamicResource Fg.Primary}" Click="OnToggleNotifications" />
                <CheckBox x:Name="QuietOn" Content="静默时段" FontSize="{x:Static controls:MarkdownStyle.SmallSize}" Margin="0,10,0,0"
                          Foreground="{DynamicResource Fg.Primary}" Click="OnToggleQuiet" />
                <StackPanel Orientation="Horizontal" Margin="24,8,0,0">
                    <TextBox x:Name="QuietStart" Width="70" LostFocus="OnQuietWindowEdited" />
                    <TextBlock Text="—" Style="{DynamicResource Text.Small}" Margin="6,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Fg.Secondary}" />
                    <TextBox x:Name="QuietEnd" Width="70" LostFocus="OnQuietWindowEdited" />
                    <TextBlock x:Name="QuietLabel" Style="{DynamicResource Text.Label}" Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Fg.Secondary}" />
                </StackPanel>
                <!-- 填歪了要说一句：两格都会按落盘值回填，没有这行就只是"我敲的 25:00 自己变回去了" -->
                <TextBlock x:Name="QuietHint" Style="{DynamicResource Text.Label}" Margin="24,6,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{DynamicResource Level.Error}" />
                <CheckBox x:Name="AutoStartOn" Content="开机自启" FontSize="{x:Static controls:MarkdownStyle.SmallSize}" Margin="0,14,0,0"
                          Foreground="{DynamicResource Fg.Primary}" Click="OnToggleAutoStart" />
                <CheckBox x:Name="CloseToTrayOn" Content="关闭窗口时最小化到托盘" FontSize="{x:Static controls:MarkdownStyle.SmallSize}" Margin="0,10,0,0"
                          Foreground="{DynamicResource Fg.Primary}" Click="OnToggleCloseToTray" />
                <TextBlock Text="这几项与托盘菜单上的是同一份设置，改哪边都一样。静默时段内只有 error 还会出声。"
                           Style="{DynamicResource Text.Label}" Margin="0,14,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Fg.Secondary}" />
            </StackPanel>

            <ScrollViewer x:Name="AboutPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="关于" Style="{DynamicResource Text.H3}" Foreground="{DynamicResource Fg.Primary}" />
                    <TextBlock x:Name="AboutVersion" Style="{DynamicResource Text.Small}" Margin="0,12,0,0"
                               Foreground="{DynamicResource Fg.Primary}" />
                    <TextBlock Text="更新检查走 GitHub Releases 的公开接口，与你在「通知」之外配置的业务服务器无关；未登录限额 60 次/小时，所以下载这一步要你亲手点。发现新版会先弹确认框，点「下载并安装」才会取包，装完再点一次系统安装。"
                               Style="{DynamicResource Text.Label}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Fg.Secondary}" />
                    <CheckBox x:Name="AutoCheckOn" Content="启动时自动检查更新" FontSize="{x:Static controls:MarkdownStyle.SmallSize}" Margin="0,12,0,0"
                              Click="OnToggleAutoCheck" Foreground="{DynamicResource Fg.Primary}" />
                    <Button x:Name="CheckUpdateButton" Content="检查更新" Margin="0,10,0,0"
                            HorizontalAlignment="Left" Click="OnCheckUpdate"
                            Style="{DynamicResource Button.Primary}" />
                    <TextBlock x:Name="UpdateStatus" Style="{DynamicResource Text.Label}" Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Fg.Primary}" />
                    <TextBlock x:Name="UpdateHint" Style="{DynamicResource Text.Label}" Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Level.Error}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
