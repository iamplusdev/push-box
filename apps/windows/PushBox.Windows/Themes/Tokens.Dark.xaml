<!-- §9.1 的深色 token：整站反色、不碰纯黑（bg.page 用 #1A1A1A 而不是 #000000）。
     键名必须与 Tokens.xaml 完全一致——ThemeManager 只是把这两份的先后顺序换一下。
     字体族、字号样式、按钮体系那批不随主题变的内容收在 Themes/Common.xaml，两份字典各自 merge 它。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Common.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 深色模式：避免纯黑，使用深灰层级。抬升的方向与浅色一致——越"浮起来"越亮 -->
    <SolidColorBrush x:Key="Bg.Page" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Bg.Elevated" Color="#2A2A2A" />
    <SolidColorBrush x:Key="Bg.Bubble.In" Color="#2A2A2C" />
    <!-- 代码底比气泡底亮一档：深色下"浮起来"的方向仍是变亮，和浅色那份正好相反 -->
    <SolidColorBrush x:Key="Bg.Code" Color="#3A3A3E" />
    <!-- 气泡描边：深色下"浮起来"的方向是变亮，所以它比气泡底浅一档（原来是 20 透明度的黑，
         压在这层深底上等于没画） -->
    <SolidColorBrush x:Key="Bg.Bubble.Border" Color="#3C3C3E" />
    <SolidColorBrush x:Key="Bg.SenderList" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Bg.Selected" Color="#2E2E2E" />
    <SolidColorBrush x:Key="Bg.AccentTint" Color="#223B2C" />
    <!-- 正文拖选的高亮底：深底上要靠"变亮 + 偏蓝"才读得出选了哪里。#223B2C 那支绿压在 #2A2A2C
         的气泡底上几乎无色差，且正文（#E0E0E0）压在这支蓝上有 5.2:1 -->
    <SolidColorBrush x:Key="Bg.TextSelection" Color="#2F5C8E" />

    <!-- 文字颜色（保证对比度） -->
    <SolidColorBrush x:Key="Fg.Primary" Color="#E0E0E0" />
    <SolidColorBrush x:Key="Fg.Secondary" Color="#9E9E9E" />

    <!-- 品牌主色深色变体。深底上要"变亮"才够得着 4.5:1（#0A8F4A 在 #2A2A2A 上只有 3.7），
         代价是白字压不住，所以压在它上面的字改用 OnAccent 的深墨绿 -->
    <SolidColorBrush x:Key="Accent" Color="#3FBF7A" />
    <SolidColorBrush x:Key="OnAccent" Color="#08170E" />

    <!-- 语义色深色模式 -->
    <SolidColorBrush x:Key="Badge.Unread" Color="#FF4D4F" />
    <SolidColorBrush x:Key="Divider" Color="#333333" />
    <SolidColorBrush x:Key="State.Offline" Color="#FFA726" />
    <!-- 连接中的蓝在深底上要走"变亮"这一侧：#1A73E8 在 #1A1A1A 上只有 3.9:1，#5B9BEF 是 6.1:1 -->
    <SolidColorBrush x:Key="State.Connecting" Color="#5B9BEF" />
    <SolidColorBrush x:Key="Level.Error" Color="#FF5252" />
    <SolidColorBrush x:Key="Level.Warning" Color="#FFB74D" />
    <SolidColorBrush x:Key="Level.Info" Color="#9E9E9E" />

    <!-- §7.4 的命中高亮：Android 那边两端同一个值（#1A73E8 + 加粗），深浅色都不换 -->
    <SolidColorBrush x:Key="Level.Highlight" Color="#1A73E8" />

    <!-- 滚动条颜色（深色模式略亮） -->
    <SolidColorBrush x:Key="ScrollBar.Thumb" Color="#6E6E6F" />
    <SolidColorBrush x:Key="ScrollBar.ThumbHover" Color="#888889" />
    <SolidColorBrush x:Key="ScrollBar.ThumbDrag" Color="#A1A1A2" />

    <!-- 按钮三态：深色下 Primary 越按越亮（深底上"浮起来"的方向是变亮），Ghost 抬灰、Danger 铺暗红；
         Accent 描边钮的 hover 复用 Bg.AccentTint，只补 pressed 一档。键名与浅色那份完全一致 -->
    <SolidColorBrush x:Key="Btn.Primary.Hover" Color="#55C98B" />
    <SolidColorBrush x:Key="Btn.Primary.Pressed" Color="#6BD39B" />
    <SolidColorBrush x:Key="Btn.Ghost.Hover" Color="#333334" />
    <SolidColorBrush x:Key="Btn.Ghost.Pressed" Color="#3D3D3E" />
    <SolidColorBrush x:Key="Btn.Accent.Pressed" Color="#2A4A36" />
    <SolidColorBrush x:Key="Btn.Danger.Hover" Color="#3B2325" />
    <SolidColorBrush x:Key="Btn.Danger.Pressed" Color="#4C2A2C" />

</ResourceDictionary>
