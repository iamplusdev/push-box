<!-- §9.1 的深色 token：整站反色、不碰纯黑（bg.page 用 #1A1A1A 而不是 #000000）。
     键名必须与 Tokens.xaml 完全一致——ThemeManager 只是把这两份的先后顺序换一下。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:PushBox.Windows.Controls">

    <!-- 深色模式：避免纯黑，使用深灰层级。抬升的方向与浅色一致——越"浮起来"越亮 -->
    <SolidColorBrush x:Key="Bg.Page" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Bg.Elevated" Color="#2A2A2A" />
    <SolidColorBrush x:Key="Bg.Bubble.In" Color="#2A2A2C" />
    <!-- 代码底比气泡底亮一档：深色下"浮起来"的方向仍是变亮，和浅色那份正好相反 -->
    <SolidColorBrush x:Key="Bg.Code" Color="#3A3A3E" />
    <!-- 气泡描边：深色下"浮起来"的方向是变亮，所以它比气泡底浅一档（原来是 20 透明度的黑，
         压在这层深底上等于没画） -->
    <SolidColorBrush x:Key="Bg.Bubble.Border" Color="#3C3C3E" />
    <SolidColorBrush x:Key="Bg.SenderList" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Bg.Selected" Color="#2E2E2E" />
    <SolidColorBrush x:Key="Bg.AccentTint" Color="#223B2C" />
    <!-- 正文拖选的高亮底：深底上要靠"变亮 + 偏蓝"才读得出选了哪里。#223B2C 那支绿压在 #2A2A2C
         的气泡底上几乎无色差，且正文（#E0E0E0）压在这支蓝上有 5.2:1 -->
    <SolidColorBrush x:Key="Bg.TextSelection" Color="#2F5C8E" />

    <!-- 文字颜色（保证对比度） -->
    <SolidColorBrush x:Key="Fg.Primary" Color="#E0E0E0" />
    <SolidColorBrush x:Key="Fg.Secondary" Color="#9E9E9E" />

    <!-- 品牌主色深色变体。深底上要"变亮"才够得着 4.5:1（#0A8F4A 在 #2A2A2A 上只有 3.7），
         代价是白字压不住，所以压在它上面的字改用 OnAccent 的深墨绿 -->
    <SolidColorBrush x:Key="Accent" Color="#3FBF7A" />
    <SolidColorBrush x:Key="OnAccent" Color="#08170E" />

    <!-- 语义色深色模式 -->
    <SolidColorBrush x:Key="Badge.Unread" Color="#FF4D4F" />
    <SolidColorBrush x:Key="Divider" Color="#333333" />
    <SolidColorBrush x:Key="State.Offline" Color="#FFA726" />
    <SolidColorBrush x:Key="Level.Error" Color="#FF5252" />
    <SolidColorBrush x:Key="Level.Warning" Color="#FFB74D" />
    <SolidColorBrush x:Key="Level.Info" Color="#9E9E9E" />

    <!-- §7.4 的命中高亮：Android 那边两端同一个值（#1A73E8 + 加粗），深浅色都不换 -->
    <SolidColorBrush x:Key="Level.Highlight" Color="#1A73E8" />

    <!-- 滚动条颜色（深色模式略亮） -->
    <SolidColorBrush x:Key="ScrollBar.Thumb" Color="#6E6E6F" />
    <SolidColorBrush x:Key="ScrollBar.ThumbHover" Color="#888889" />
    <SolidColorBrush x:Key="ScrollBar.ThumbDrag" Color="#A1A1A2" />

    <!-- 按钮三态：深色下 Primary 越按越亮（深底上"浮起来"的方向是变亮），Ghost 抬灰、Danger 铺暗红；
         Accent 描边钮的 hover 复用 Bg.AccentTint，只补 pressed 一档。键名与浅色那份完全一致 -->
    <SolidColorBrush x:Key="Btn.Primary.Hover" Color="#55C98B" />
    <SolidColorBrush x:Key="Btn.Primary.Pressed" Color="#6BD39B" />
    <SolidColorBrush x:Key="Btn.Ghost.Hover" Color="#333334" />
    <SolidColorBrush x:Key="Btn.Ghost.Pressed" Color="#3D3D3E" />
    <SolidColorBrush x:Key="Btn.Accent.Pressed" Color="#2A4A36" />
    <SolidColorBrush x:Key="Btn.Danger.Hover" Color="#3B2325" />
    <SolidColorBrush x:Key="Btn.Danger.Pressed" Color="#4C2A2C" />

    <!-- §9.2 的字体层级系统（深色主题复用浅色定义的样式，字体族与字号不随主题变化）。
         与浅色那份同一批 {x:Static} 引用：两份键名必须一致，数值也只有 Controls/MarkdownView.cs 一份 -->
    <!-- 基础字体族 -->
    <FontFamily x:Key="Font.UI">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Code">Consolas, Microsoft YaHei UI</FontFamily>
    <!-- 图标字体：与浅色那份同一个值，字形不随主题变，颜色跟 Foreground 走 -->
    <FontFamily x:Key="Font.Icon">Segoe MDL2 Assets</FontFamily>

    <!-- H1: 20px / 行高 28 / Bold -->
    <Style x:Key="Text.H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.H1Size}" />
        <Setter Property="LineHeight" Value="{x:Static controls:MarkdownStyle.H1Line}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- H2: 18px / 行高 25 / Bold -->
    <Style x:Key="Text.H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.H2Size}" />
        <Setter Property="LineHeight" Value="{x:Static controls:MarkdownStyle.H2Line}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- H3: 16px / 行高 22 / SemiBold (会话名) -->
    <Style x:Key="Text.H3" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.H3Size}" />
        <Setter Property="LineHeight" Value="{x:Static controls:MarkdownStyle.H3Line}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- Body: 15px / 行高 23 / Normal (消息正文) -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.BodySize}" />
        <Setter Property="LineHeight" Value="{x:Static controls:MarkdownStyle.BodyLine}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- Small: 13px / 行高 18 / Normal (摘要、副文本) -->
    <Style x:Key="Text.Small" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
        <Setter Property="LineHeight" Value="{x:Static controls:MarkdownStyle.SmallLine}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- Label: 12px / 行高 16 / Normal (时间戳、角标、提示) -->
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.LabelSize}" />
        <Setter Property="LineHeight" Value="{x:Static controls:MarkdownStyle.LabelLine}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- Code: 13px / 行高 18 / Monospace (恢复码、设备 ID、curl 命令) -->
    <Style x:Key="Text.Code" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
        <Setter Property="LineHeight" Value="{x:Static controls:MarkdownStyle.SmallLine}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Code}" />
    </Style>

    <!-- 按钮体系：五个键与浅色那份逐字相同（颜色一律 DynamicResource，换主题时自己跟着走）。
         两份都放是因为 ThemeManager 换的是"哪一份在前"，键少一边那一面就悄悄退回 WPF 默认灰钮 -->
    <Style x:Key="Button.Primary" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Visual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource Accent}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Primary.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Primary.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Secondary" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Visual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderThickness="1" CornerRadius="6"
                            BorderBrush="{DynamicResource Divider}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Ghost.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Ghost.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Accent" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Visual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderThickness="1" CornerRadius="6"
                            BorderBrush="{DynamicResource Accent}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.AccentTint}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Accent.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Danger" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Level.Error}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Visual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderThickness="1" CornerRadius="6"
                            BorderBrush="{DynamicResource Level.Error}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Danger.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Danger.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 图标钮（顶栏 ⚙、返回 ←）：字形与尺寸由挂它的地方给，这一份只管三态底色与焦点框 -->
    <Style x:Key="Button.Icon" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Icon}" />
        <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Visual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Ghost.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Ghost.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "N 条新消息"胶囊：与浅色那份同一套（三态用的是 Ghost 的 hover/pressed 两档灰） -->
    <Style x:Key="Button.Pill" TargetType="Button">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Visual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource Bg.Elevated}" BorderThickness="1" CornerRadius="12"
                            BorderBrush="{DynamicResource Divider}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Ghost.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Ghost.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 键盘焦点框：与浅色那份同一套（Accent 换字典时自己跟着走） -->
    <Style x:Key="Focus.Visual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="1" CornerRadius="6" BorderThickness="2"
                            BorderBrush="{DynamicResource Accent}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
