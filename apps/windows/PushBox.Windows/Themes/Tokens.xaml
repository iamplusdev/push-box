<!-- §9.1 的颜色 token（浅色）。深色那份在 Themes/Tokens.Dark.xaml，同一个键名、只有值不同，
     所以 ThemeManager 换的是"哪一份在前"，控件那边一律用 {DynamicResource} 不用硬编码色。
     字体族、字号样式、按钮体系那批不随主题变的内容收在 Themes/Common.xaml，两份字典各自 merge 它。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Common.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 页面与卡片背景。层级是"页面最暗、卡片与菜单浮在最上面"：
         卡片必须先比页面亮，边框（Divider）才有地方显形——两者同色时那 1px 等于没画 -->
    <SolidColorBrush x:Key="Bg.Page" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Bg.Bubble.In" Color="#E8E8EA" />
    <!-- 行内码与代码块的底：必须和气泡底分开一档，否则等宽字落在同色底上等于没画
         （Android 那边是白气泡配 #EEEEEE 的 surfaceVariant；PC 的气泡本身已经比白深，所以再往下压一档） -->
    <SolidColorBrush x:Key="Bg.Code" Color="#D8D8DC" />
    <!-- 气泡那 1px 描边：气泡底与页面底都是灰，"微弱"到和底同色时相邻气泡会糊成一片。
         比 Divider 浅一档，只够勾出轮廓而不抢正文 -->
    <SolidColorBrush x:Key="Bg.Bubble.Border" Color="#D6D6D8" />
    <SolidColorBrush x:Key="Bg.SenderList" Color="#EEEFF0" />
    <!-- 会话行选中底：比列表底深一档的灰（微信 PC 那档），不铺 accent——整行染绿太吵 -->
    <SolidColorBrush x:Key="Bg.Selected" Color="#E2E2E2" />
    <!-- 选中项/开关的浅绿底：accent 只做圆点与文字，整块铺绿太吵 -->
    <SolidColorBrush x:Key="Bg.AccentTint" Color="#E6F9EF" />
    <!-- 正文拖选的高亮底。不复用 Bg.AccentTint：那支绿和气泡底 #E8E8EA 只差一档色相偏移，
         铺在正文上"选中了哪里"根本读不出来（2026-10-27 的实测抱怨）。走偏蓝是因为选中态在
         任何主题里都不该和"品牌绿"或"底色"混在一起，且 #19191A 的正文压上去仍有 12.8:1。 -->
    <SolidColorBrush x:Key="Bg.TextSelection" Color="#BFE0FF" />

    <!-- 文字颜色。#5F5F5F 是对比度兜底：13px 次要字落在 #E0E0E0 那类底上时，
         原来的 #757575 只有 3.5:1；#5F5F5F 在页面/卡片/列表三种底上都在 5:1 以上 -->
    <SolidColorBrush x:Key="Fg.Primary" Color="#19191A" />
    <SolidColorBrush x:Key="Fg.Secondary" Color="#5F5F5F" />

    <!-- 品牌主色（微信风格绿）。#0F7A4F 的白字对比度 5.4:1：
         它同时当按钮底和正文色，浅绿 #0ABF5E 那类只够当 ≥18px 粗体的装饰色 -->
    <SolidColorBrush x:Key="Accent" Color="#0F7A4F" />
    <!-- 压在 Accent 实底上的字（主按钮）。深色主题的主色偏亮，所以那一边是深字 -->
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />

    <!-- 语义色 -->
    <SolidColorBrush x:Key="Badge.Unread" Color="#F5222D" />
    <!-- 分割线要比菜单底/卡片底都深一档：与 Bg.Elevated 同值时，菜单栏的右边框直接消失 -->
    <SolidColorBrush x:Key="Divider" Color="#CFCFCF" />
    <SolidColorBrush x:Key="State.Offline" Color="#FF8C00" />
    <!-- 连接中是第四态，不再复用离线橙：橙留给"断了要人管"，蓝留给"正在自己好"。
         连接中那两个字要压在 #FAFAFA 的顶栏上，#1A73E8 只有 4.3:1，#155FBD 是 5.9:1 -->
    <SolidColorBrush x:Key="State.Connecting" Color="#155FBD" />
    <SolidColorBrush x:Key="Level.Error" Color="#F5222D" />
    <SolidColorBrush x:Key="Level.Warning" Color="#FF8C00" />
    <SolidColorBrush x:Key="Level.Info" Color="#757575" />

    <!-- §7.4 的命中高亮：Android 那边是硬编码的 #1A73E8 且加粗，深浅两色同一个值，所以两份字典里都一样 -->
    <SolidColorBrush x:Key="Level.Highlight" Color="#1A73E8" />

    <!-- 滚动条颜色 -->
    <SolidColorBrush x:Key="ScrollBar.Thumb" Color="#A1A1A2" />
    <SolidColorBrush x:Key="ScrollBar.ThumbHover" Color="#888889" />
    <SolidColorBrush x:Key="ScrollBar.ThumbDrag" Color="#6E6E6F" />

    <!-- 按钮三态：默认态用已有 token（Accent 实底 / Divider 描边 / Level.Error 描边），
         这里只补 hover 与 pressed 那两档。浅色下 Primary 越按越深、Ghost 铺灰、Danger 铺浅红；
         Accent 描边钮的 hover 复用 Bg.AccentTint，只补 pressed 一档 -->
    <SolidColorBrush x:Key="Btn.Primary.Hover" Color="#0C6742" />
    <SolidColorBrush x:Key="Btn.Primary.Pressed" Color="#0A5536" />
    <SolidColorBrush x:Key="Btn.Ghost.Hover" Color="#EFEFF0" />
    <SolidColorBrush x:Key="Btn.Ghost.Pressed" Color="#E2E2E4" />
    <SolidColorBrush x:Key="Btn.Accent.Pressed" Color="#CFF3E1" />
    <SolidColorBrush x:Key="Btn.Danger.Hover" Color="#FDECEC" />
    <SolidColorBrush x:Key="Btn.Danger.Pressed" Color="#FAD9D9" />

</ResourceDictionary>
