<!-- §9.1 的颜色 token（浅色）。深色那份在 Themes/Tokens.Dark.xaml，同一个键名、只有值不同，
     所以 ThemeManager 换的是"哪一份在前"，控件那边一律用 {DynamicResource} 不用硬编码色。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 页面与卡片背景。层级是"页面最暗、卡片与菜单浮在最上面"：
         卡片必须先比页面亮，边框（Divider）才有地方显形——两者同色时那 1px 等于没画 -->
    <SolidColorBrush x:Key="Bg.Page" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Bg.Bubble.In" Color="#E8E8EA" />
    <SolidColorBrush x:Key="Bg.SenderList" Color="#EEEFF0" />
    <!-- 会话行选中底：比列表底深一档的灰（微信 PC 那档），不铺 accent——整行染绿太吵 -->
    <SolidColorBrush x:Key="Bg.Selected" Color="#E2E2E2" />
    <!-- 选中项/开关的浅绿底：accent 只做圆点与文字，整块铺绿太吵 -->
    <SolidColorBrush x:Key="Bg.AccentTint" Color="#E6F9EF" />

    <!-- 文字颜色。#5F5F5F 是对比度兜底：13px 次要字落在 #E0E0E0 那类底上时，
         原来的 #757575 只有 3.5:1；#5F5F5F 在页面/卡片/列表三种底上都在 5:1 以上 -->
    <SolidColorBrush x:Key="Fg.Primary" Color="#19191A" />
    <SolidColorBrush x:Key="Fg.Secondary" Color="#5F5F5F" />

    <!-- 品牌主色（微信风格绿）。#0F7A4F 的白字对比度 5.4:1：
         它同时当按钮底和正文色，浅绿 #0ABF5E 那类只够当 ≥18px 粗体的装饰色 -->
    <SolidColorBrush x:Key="Accent" Color="#0F7A4F" />
    <!-- 压在 Accent 实底上的字（主按钮）。深色主题的主色偏亮，所以那一边是深字 -->
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />

    <!-- 语义色 -->
    <SolidColorBrush x:Key="Badge.Unread" Color="#F5222D" />
    <!-- 分割线要比菜单底/卡片底都深一档：与 Bg.Elevated 同值时，菜单栏的右边框直接消失 -->
    <SolidColorBrush x:Key="Divider" Color="#CFCFCF" />
    <SolidColorBrush x:Key="State.Offline" Color="#FF8C00" />
    <SolidColorBrush x:Key="Level.Error" Color="#F5222D" />
    <SolidColorBrush x:Key="Level.Warning" Color="#FF8C00" />
    <SolidColorBrush x:Key="Level.Info" Color="#757575" />

    <!-- §7.4 的命中高亮：Android 那边是硬编码的 #1A73E8 且加粗，深浅两色同一个值，所以两份字典里都一样 -->
    <SolidColorBrush x:Key="Level.Highlight" Color="#1A73E8" />

    <!-- 滚动条颜色 -->
    <SolidColorBrush x:Key="ScrollBar.Thumb" Color="#A1A1A2" />
    <SolidColorBrush x:Key="ScrollBar.ThumbHover" Color="#888889" />
    <SolidColorBrush x:Key="ScrollBar.ThumbDrag" Color="#6E6E6F" />

    <!-- §9.2 的字体层级系统（字号常量）。XAML 无法直接引用 C# 常量，所以在资源字典中定义 Style。
         正文 15/行高23、摘要 13/行高18、标签 12/行高16、标题四档 20/18/16/15。
         字体族：Segoe UI + Microsoft YaHei UI（UI），Consolas + YaHei UI（代码）。 -->

    <!-- 基础字体族 -->
    <FontFamily x:Key="Font.UI">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Code">Consolas, Microsoft YaHei UI</FontFamily>

    <!-- H1: 20px / Bold -->
    <Style x:Key="Text.H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- H2: 18px / Bold -->
    <Style x:Key="Text.H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- H3: 16px / SemiBold (会话名) -->
    <Style x:Key="Text.H3" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- Body: 15px / Normal (消息正文) -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="23" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- Small: 13px / Normal (摘要、副文本) -->
    <Style x:Key="Text.Small" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- Label: 12px / Normal (时间戳、角标、提示) -->
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- Code: 13px / Monospace (恢复码、设备 ID、curl 命令) -->
    <Style x:Key="Text.Code" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Code}" />
    </Style>

</ResourceDictionary>
