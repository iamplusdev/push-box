<!-- 两份 token 字典里逐字相同的部分：字体族、§9.2 的字号样式、§9.4 的按钮体系、键盘焦点框。
     Tokens.xaml / Tokens.Dark.xaml 只留颜色值并 merge 本文件——颜色一律 DynamicResource，
     换主题时样式里引用的色跟着字典走，样式本身不需要两份。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:PushBox.Windows.Controls">

    <!-- §9.2 的字体层级系统（字号常量）。XAML 用 {x:Static} 直接引用 Controls/MarkdownView.cs 里
         那组 const——数字只写一份，改档位时这里跟着走（TypographyTest 会读文件逐条比）。
         正文 15/行高23、摘要 13/行高18、标签 12/行高16、标题四档 20/28、18/25、16/22、15/23。
         字体族：Segoe UI + Microsoft YaHei UI（UI），Consolas + YaHei UI（代码）。 -->

    <!-- 基础字体族 -->
    <FontFamily x:Key="Font.UI">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Code">Consolas, Microsoft YaHei UI</FontFamily>
    <!-- 图标字体：系统自带的 Segoe MDL2 Assets。⚙/← 那类 emoji 与 ✅/⚠️ 彩符在深浅两色下
         都不跟 token 走（彩符根本染不了色），换成字形后颜色随 Foreground、字形随系统字体 -->
    <FontFamily x:Key="Font.Icon">Segoe MDL2 Assets</FontFamily>

    <!-- H1: 20px / 行高 28 / Bold -->
    <Style x:Key="Text.H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.H1Size}" />
        <Setter Property="LineHeight" Value="{x:Static controls:MarkdownStyle.H1Line}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- H2: 18px / 行高 25 / Bold -->
    <Style x:Key="Text.H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.H2Size}" />
        <Setter Property="LineHeight" Value="{x:Static controls:MarkdownStyle.H2Line}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- H3: 16px / 行高 22 / SemiBold (会话名) -->
    <Style x:Key="Text.H3" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.H3Size}" />
        <Setter Property="LineHeight" Value="{x:Static controls:MarkdownStyle.H3Line}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- Body: 15px / 行高 23 / Normal (消息正文) -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.BodySize}" />
        <Setter Property="LineHeight" Value="{x:Static controls:MarkdownStyle.BodyLine}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- Small: 13px / 行高 18 / Normal (摘要、副文本) -->
    <Style x:Key="Text.Small" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
        <Setter Property="LineHeight" Value="{x:Static controls:MarkdownStyle.SmallLine}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- Label: 12px / 行高 16 / Normal (时间戳、角标、提示) -->
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.LabelSize}" />
        <Setter Property="LineHeight" Value="{x:Static controls:MarkdownStyle.LabelLine}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- Code: 13px / 行高 18 / Monospace (恢复码、设备 ID、curl 命令) -->
    <Style x:Key="Text.Code" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
        <Setter Property="LineHeight" Value="{x:Static controls:MarkdownStyle.SmallLine}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Code}" />
    </Style>

    <!-- 按钮体系：六个键覆盖全部场景——Primary 实底、Secondary 中性描边、Accent 主色描边、
         Danger 危险描边、Icon 纯字形、Pill 悬浮胶囊。三态（默认/hover/pressed）加禁用与键盘焦点全在模板触发器里，
         窗口那边只挂 Style，不再写 Background/BorderBrush 内联属性（写回去就等于这一处不参加换肤）。
         颜色一律 DynamicResource，换主题时自己跟着走 -->
    <Style x:Key="Button.Primary" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Visual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource Accent}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Primary.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Primary.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Secondary" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Visual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderThickness="1" CornerRadius="6"
                            BorderBrush="{DynamicResource Divider}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Ghost.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Ghost.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Accent" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Visual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderThickness="1" CornerRadius="6"
                            BorderBrush="{DynamicResource Accent}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.AccentTint}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Accent.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Danger" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Level.Error}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Visual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderThickness="1" CornerRadius="6"
                            BorderBrush="{DynamicResource Level.Error}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Danger.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Danger.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 图标钮（顶栏 ⚙、返回 ←）：字形与尺寸由挂它的地方给（Content=&#xE713; + x:Static 字号），
         这一份只管三态底色与焦点框 -->
    <Style x:Key="Button.Icon" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Icon}" />
        <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Visual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Ghost.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Ghost.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "N 条新消息"胶囊：悬在对话区底部。它原来是个只认鼠标的 Border——键盘用户既 Tab 不到也按不动；
         收成按钮后 Space/Enter、焦点框与禁用态全都是白拿的 -->
    <Style x:Key="Button.Pill" TargetType="Button">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontSize" Value="{x:Static controls:MarkdownStyle.SmallSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Visual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource Bg.Elevated}" BorderThickness="1" CornerRadius="12"
                            BorderBrush="{DynamicResource Divider}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Ghost.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Ghost.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 键盘焦点框：2px Accent 内描边。会话行原来把 FocusVisualStyle 置成 null，
         Tab 过去完全看不出焦点停在哪；这条替代 WPF 默认那圈点线，深浅两套都用主色 -->
    <Style x:Key="Focus.Visual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="1" CornerRadius="6" BorderThickness="2"
                            BorderBrush="{DynamicResource Accent}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
