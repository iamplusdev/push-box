<Window x:Class="PushBox.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PushBox.Windows.Controls"
        xmlns:views="clr-namespace:PushBox.Windows.Views"
        Title="PushBox" Width="1080" Height="680" MinWidth="440" MinHeight="420"
        Background="{DynamicResource Bg.Page}"
        FontFamily="{DynamicResource Font.UI}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <!-- §8.1 的窗口结构：微信风格三栏布局 —— 最左侧菜单栏（设置+连接状态）、中间消息列表、右侧对话信息。
         这里只放控件与模板，所有判定（选中、筛选、分节、单双栏）都在 MainModel 与 code-behind 里。 -->
    <Window.Resources>
        <views:TokenBrushConverter x:Key="TokenBrush" />
        <views:NullOrEmptyToVisibilityConverter x:Key="HasValue" />

        <!-- 会话行的选中态：整条铺 Accent（§9.1 的微信口径），hover 比列表底色浅一档。
             颜色一律走 token，深色主题换字典时这一行才会跟着反色。
             焦点框也走 token：这一行原来把 FocusVisualStyle 置空，键盘走过去看不出焦点在哪。 -->
        <Style x:Key="ConversationRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Visual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Shell" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Rail" Background="Transparent" />
                                <ContentPresenter Grid.Column="1" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Bg.Page}" />
                            </Trigger>
                            <!-- 后声明的触发器覆盖先声明的，所以选中态压得住 hover。
                                 选中底是比列表深一档的灰（微信 PC 那档），整行染绿太吵；
                                 "哪一条被选中"由左侧 3px 的 accent 竖条负责，字色不变 -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Bg.Selected}" />
                                <Setter TargetName="Rail" Property="Background" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- §9.2 的会话行：行高 64、头像 44 圆角 6（微信式方圆形，不是正圆）、左内边距 16 右 8、
             分割线起于文本起点。名称 16 / 摘要 13 / 时间 12，未读是纯数字而不是红点（与 Android 一致）。
             右边收到 8 是因为"列表内容与消息头像之间那条空白带"由三段相加（行右边距 + 手柄列 +
             时间线左内边距），三段各让一档才从 32 降到 20；这条带由 PaneGapTest 钉住。 -->
        <DataTemplate x:Key="ConversationRowTemplate">
            <Grid Margin="16,0,8,0">
                <!-- §8.4 W14 的清空入口与 §7.3 的三项本机设置。它们挂在这一行而不是右上角 ⋮ 上，
                     是因为两个菜单的作用域不同：⋮ 那三项管的是"当前打开的那条"，
                     而这里管的是"右键点到的这一行"——没打开的会话也要能改名、置顶、清空。
                     置顶/免打扰那两行的字由 OnConversationMenuOpening 按这一行的现状态改写（置顶 ↔ 取消置顶）；
                     确认框与那句人话都在 MainModel，模板只负责把它们摆出来 -->
                <Grid.ContextMenu>
                    <ContextMenu Opened="OnConversationMenuOpening">
                        <MenuItem Tag="pin" Header="置顶" Click="OnTogglePin" />
                        <MenuItem Tag="mute" Header="免打扰" Click="OnToggleMute" />
                        <MenuItem Tag="rename" Header="重命名…" Click="OnRenameConversation" />
                        <MenuItem Tag="avatar" Header="设头像…" Click="OnSetAvatar" />
                        <Separator />
                        <MenuItem Tag="clear" Header="清空聊天记录" Click="OnClearConversation" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- 头像是个自绘的小控件：本机设过的文件 → 服务端转存的头像 → 首字占位，三种形态按这个顺序落。
                         绑定只交出字符串，取字节由窗口挂的 AvatarBox.Loader 在后台补上（§4.5） -->
                    <controls:AvatarBox Grid.Column="0" Width="44" Height="44" Side="44"
                                        DisplayName="{Binding DisplayName}" Token="{Binding AvatarToken}"
                                        LocalPath="{Binding AvatarPath}" />
                    <!-- 名称必须是"星号列 + 省略号"：塞在横向 StackPanel 里时它按内容取宽，
                         TextTrimming 永远不触发，长名字会把右边的置顶/静音和时间挤出去 -->
                    <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- §9.1 的会话行小圆点：只有 warning/error 才有 -->
                            <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Fill="{Binding LevelDotKey, Converter={StaticResource TokenBrush}}"
                                     Visibility="{Binding LevelDotKey, Converter={StaticResource HasValue}}" />
                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Style="{DynamicResource Text.H3}"
                                       Foreground="{DynamicResource Fg.Primary}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                            <TextBlock Grid.Column="2" Text="{Binding FlagsText}" Style="{DynamicResource Text.Label}"
                                       VerticalAlignment="Center" Margin="2,0,0,0"
                                       Foreground="{DynamicResource Fg.Secondary}" />
                        </Grid>
                        <!-- 摘要限两行：Text.Small 行高 18，36 正好两行；开 Wrap 之后
                             截断才落在第二行末尾，而不是把整段压成一行。
                             用 EmojiTextBlock 而不是 TextBlock：它的 Source 是真依赖属性，
                             换绑定的时候顺带把 emoji 换成彩色字形（Emoji.Wpf 那个 Text 不是 DP，绑不上） -->
                        <controls:EmojiTextBlock Grid.Row="1" Source="{Binding Summary}"
                                                 Style="{DynamicResource Text.Small}"
                                                 Margin="0,2,0,0" MaxHeight="36" TextWrapping="Wrap"
                                                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}"
                                                 Foreground="{DynamicResource Fg.Secondary}" />
                    </Grid>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                Margin="10,0,0,0">
                        <TextBlock Text="{Binding ClockText}" Style="{DynamicResource Text.Label}"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Fg.Secondary}" />
                        <TextBlock Text="{Binding UnreadText}" Style="{DynamicResource Text.Small}"
                                   HorizontalAlignment="Right" Margin="0,2,0,0"
                                   Foreground="{DynamicResource Badge.Unread}" />
                    </StackPanel>
                </Grid>
                <!-- 分割线起于文本 x：外层已吃掉 16 的页边距，所以这里缩进 44 + 10 -->
                <Border Grid.Row="1" Height="1" Margin="54,0,0,0"
                        Background="{DynamicResource Divider}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- §8.4 W14 的回滚提示：删除没成要说一句人话（§9.3 的行内口径，不弹 Toast），点它消失。
             它挂在顶栏下面而不是右栏里，是因为清空失败时右栏已经退回"没选中"、窄窗口那一栏的宽度还是 0——
             放进去等于没放。Height=Auto：这句话长度不固定（服务端给的理由跟着错误码变），写死 24 会把它截掉。 -->
        <Border DockPanel.Dock="Top" x:Name="NoticeBar" Padding="16,6" Visibility="Collapsed"
                Background="{DynamicResource Bg.Elevated}" Cursor="Hand"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"
                MouseLeftButtonUp="OnNoticeDismissed">
            <DockPanel>
                <!-- 整条也能点，但"能点"对键盘用户等于不存在：留一颗真的按钮，Tab 得到、读屏也念得出 -->
                <Button DockPanel.Dock="Right" x:Name="NoticeCloseButton" Content="&#xE711;"
                        Style="{DynamicResource Button.Icon}" Width="24" Height="24" Margin="12,0,0,0"
                        FontSize="{x:Static controls:MarkdownStyle.SmallSize}"
                        AutomationProperties.Name="关闭提示" ToolTip="关闭提示" Click="OnNoticeClosed" />
                <TextBlock x:Name="NoticeText" Style="{DynamicResource Text.Small}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Foreground="{DynamicResource Level.Error}" />
            </DockPanel>
        </Border>

        <Grid x:Name="Body">
            <Grid.ColumnDefinitions>
                <!-- 最左侧菜单栏：60px 宽（图标按钮 + 连接状态） -->
                <ColumnDefinition Width="60" />
                <!-- 中间消息列表栏：这里的 260/200-400 只是设计期的初值。
                     运行时由 ApplyPaneWidth 按 MainModel.PaneLayoutFor 重设宽度与上下限——
                     窄屏要把列表收成 0，只改 Width 会被 MinWidth 夹住 -->
                <ColumnDefinition Width="260" MinWidth="200" MaxWidth="400" />
                <!-- 拖拽手柄所在的窄列：它同时也是列表与对话区之间那条分割线，
                     所以列表那边不再自己画右边框，否则会出现"边框一条线、手柄另一条线" -->
                <ColumnDefinition Width="4" />
                <!-- 右侧对话区：占据剩余空间 -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 最左侧：菜单栏（设置按钮 + 连接状态） -->
            <Border Grid.Column="0" Background="{DynamicResource Bg.Elevated}"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- 底部：设置按钮 -->
                    <Border DockPanel.Dock="Bottom" Height="48" Padding="0,8"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
                        <Button x:Name="SettingsButton" Content="&#xE713;"
                                Style="{DynamicResource Button.Icon}"
                                Width="36" Height="36"
                                FontSize="{x:Static controls:MarkdownStyle.H2Size}"
                                AutomationProperties.Name="设置"
                                ToolTip="设置（Alt+S）" Click="OnOpenSettings" />
                    </Border>
                    <!-- 顶部：连接状态指示。正文只有两字（"在线/离线/异常"），原因挂在整块的悬停提示上——
                         挂在 10px 那颗点上等于没有，鼠标很难正好停在上面 -->
                    <StackPanel x:Name="StatusArea" DockPanel.Dock="Top" VerticalAlignment="Top"
                                HorizontalAlignment="Center" Margin="0,16,0,0">
                        <!-- 没有 SyncEngine 时不显示状态点（测试用例的 idle 态） -->
                        <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                 Fill="{DynamicResource State.Offline}"
                                 Visibility="Collapsed" />
                        <TextBlock x:Name="StatusText" Style="{DynamicResource Text.Label}"
                                   Margin="0,4,0,0" TextAlignment="Center"
                                   Foreground="{DynamicResource Fg.Secondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 中间：会话列表。右边框故意不画——那条线由紧挨着的拖拽手柄充当（见下） -->
            <Border Grid.Column="1" Background="{DynamicResource Bg.SenderList}">
                <Grid>
                    <ListBox x:Name="ConversationList" BorderThickness="0"
                             Background="Transparent" 
                             controls:ScrollReveal.Attach="True"
                             AutomationProperties.Name="会话列表"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemTemplate="{StaticResource ConversationRowTemplate}"
                             ItemContainerStyle="{StaticResource ConversationRowStyle}"
                             HorizontalContentAlignment="Stretch" />
                    <!-- 空状态整块是一个 Grid：TextBlock 的内容只收 Inline，直接把 StackPanel 塞进去会在
                         运行时抛 XamlParseException，而它在编译期一点都不报错 -->
                    <Grid x:Name="ConversationEmpty" Visibility="Collapsed" Margin="24,48,24,0" VerticalAlignment="Top">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="M50,20 C50,10 40,0 30,0 L10,0 C5,0 0,5 0,10 L0,30 C0,35 5,40 10,40 L25,40 L35,50 L35,40 L30,40 C25,40 20,35 20,30 L20,10 C20,5 25,0 30,0 Z M50,20" 
                                  Fill="{DynamicResource Fg.Secondary}" 
                                  Opacity="0.2"
                                  Width="64" Height="64" 
                                  Stretch="Uniform"
                                  Margin="0,0,0,16"/>
                            <TextBlock x:Name="ConversationEmptyTitle" Text="还没有频道" Style="{DynamicResource Text.H3}" 
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Fg.Primary}"
                                       Margin="0,0,0,8"/>
                            <TextBlock x:Name="ConversationEmptyDetail" Text="在手机上创建频道，或用 curl 发送第一条消息" Style="{DynamicResource Text.Small}"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Fg.Secondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>
                            <!-- 同一颗按钮两种去向（建频道 / 重试回放），由模型给的 EmptyAction 决定，
                                 Tag 记这一轮该走哪条 -->
                            <Button x:Name="ConversationEmptyButton" Content="打开设置创建频道"
                                    Click="OnConversationEmptyAction"
                                    Style="{DynamicResource Button.Accent}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 可拖拽调整列宽的手柄：4px 的命中区里只画 1px 的线，
                 所以它既是分割线又是拖拽把手，视觉上和列表右边缘完全重合 -->
            <GridSplitter x:Name="ListSplitter" Grid.Column="2"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE"
                          AutomationProperties.Name="调整会话列表宽度"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border Width="1" HorizontalAlignment="Center"
                                    Background="{DynamicResource Divider}" />
                        </Grid>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- 右侧：对话区 -->
            <Grid Grid.Column="3" x:Name="ConversationPane">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Grid.Column="0" Content="&#xE72B;" Width="28" Height="28"
                            Style="{DynamicResource Button.Icon}" Visibility="Collapsed"
                            FontSize="{x:Static controls:MarkdownStyle.H3Size}"
                            AutomationProperties.Name="返回"
                            ToolTip="返回（Alt+←）" />
                    <TextBlock x:Name="ConversationTitle" Grid.Column="1" Margin="10,0,0,0"
                               Style="{DynamicResource Text.H3}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Fg.Primary}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </Grid>

                <Grid Grid.Row="1">
                    <!-- 虚拟化：滚动条必须长在 ItemsControl 自己的模板里。外面再套一个 ScrollViewer 的话，
                         面板会被按无限高测量，虚拟化整个失效——几千条历史就会在每次切会话时全量排版一遍。
                         这一层铺满整个对话区：滚动条因此贴在最右边，而消息列的上限交给模板里的
                         ItemsPresenter 去钉（见 ApplyPaneWidth）——给这一层设 MaxWidth 会连滚动条一起缩进来。 -->
                    <ItemsControl x:Name="Timeline"
                                  controls:ScrollReveal.Attach="True"
                                  controls:TimelineRow.Config="{Binding RowConfig, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                  AutomationProperties.Name="消息"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <!-- 左内边距 8（原来四边都是 12）：这一档减的是"头像离列表太远"那三段里的
                                     第三段，上下右三段不动——上面要与顶栏留呼吸、右面要给滚动条让位。 -->
                                <ScrollViewer x:Name="TimelineScroll"
                                              CanContentScroll="True"
                                              Padding="8,12,12,12"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <!-- 消息列：靠左、宽度由 ApplyPaneWidth 钉成 BubbleMaxWidth（固定的那一档，
                                         不按内容收——否则宽气泡被回收时整列会跟着缩，日期头跳来跳去）。
                                         滚动条不在这里，它由外面的 ScrollViewer 铺满整个对话区后贴在最右边 -->
                                    <ItemsPresenter x:Name="TimelinePresenter"
                                                    HorizontalAlignment="Left" />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <!-- 行是"数据"而不是"建好的控件"：屏外的条目因此连气泡都没有，只有面板生成出来的
                             那几行才走 TimelineRow 建一棵树。配置挂在时间线上、按继承传下来（换主题才换一份），
                             不在这里绑——行根节点上绑 Window 要先等接到树上才落地，面板第一次量时行高还是 0 -->
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:TimelineRow Item="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="FrameworkElement">
                                <Setter Property="Margin" Value="0,0,0,8" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>

                    <!-- 空态三句：正在取 / 确实没有 / 没取回来。回放没结束之前不许说"还没有消息"——
                         那台机器可能只是还没取回来。失败时底下那颗按钮是唯一能做的事 -->
                    <StackPanel x:Name="TimelineEmpty" Visibility="Collapsed"
                                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,48,0,0">
                        <TextBlock x:Name="TimelineEmptyTitle" Style="{DynamicResource Text.Small}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Fg.Secondary}" />
                        <Button x:Name="TimelineRetryButton" Content="重试" Visibility="Collapsed"
                                Margin="0,12,0,0" HorizontalAlignment="Center"
                                Style="{DynamicResource Button.Secondary}"
                                Click="OnTimelineRetry" />
                    </StackPanel>
                </Grid>

                <!-- §9.3 空会话/未选中：插画 + 文案。这一块是**要**居中的（它不是消息列表，是一句提示） -->
                <Border Grid.Row="1" x:Name="NoConversationBar" Background="{DynamicResource Bg.Page}">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- 简单的对话气泡插画（使用 Path 绘制） -->
                            <Path Data="M50,20 C50,10 40,0 30,0 L10,0 C5,0 0,5 0,10 L0,30 C0,35 5,40 10,40 L25,40 L35,50 L35,40 L30,40 C25,40 20,35 20,30 L20,10 C20,5 25,0 30,0 Z M50,20" 
                                  Fill="{DynamicResource Fg.Secondary}" 
                                  Opacity="0.2"
                                  Width="80" Height="80" 
                                  Stretch="Uniform"
                                  Margin="0,0,0,16"/>
                            
                            <TextBlock Text="从左侧选一条会话线" Style="{DynamicResource Text.H3}" 
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Fg.Primary}"
                                       Margin="0,0,0,8"/>
                            
                            <TextBlock Text="选择一个会话开始聊天" Style="{DynamicResource Text.Small}"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Fg.Secondary}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- §9.3 的"1 条新消息"胶囊：只有用户正往上翻历史（没贴在底部）时才出现，点它回到底部。
                     贴在底部时新消息直接跟滚，不需要这一格。
                     它原来是个只认鼠标的 Border：键盘用户既 Tab 不到也按不动，收成按钮才算真能按 -->
                <Button x:Name="NewBelow" Grid.Row="2" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                        Style="{DynamicResource Button.Pill}" Click="OnNewBelowClicked"
                        AutomationProperties.Name="新消息，跳到底部">
                    <TextBlock x:Name="NewBelowText" Style="{DynamicResource Text.Small}"
                               Foreground="{DynamicResource Accent}" />
                </Button>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
