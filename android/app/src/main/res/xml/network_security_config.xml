<?xml version="1.0" encoding="utf-8"?>
<!--
  §11.1：明文 http+ws 的局域网/Tailscale 部署是定稿的允许项（自建服务常只有 IP 与端口、没有可信证书），
  Android 9+ 默认禁止明文，所以这里整体放行。保密不靠这一层——正文在 TLS 之下还有 §4 的密封盒。
  上自签 CA 的 HTTPS 时这份文件不用整份换掉：base-config 只信任 src="system"，用户级安装的根 CA 它不认，
  要么把 CA 装进系统信任存储，要么显式加 <certificates src="@raw/pb_ca"/>。口径见 §11.2。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
