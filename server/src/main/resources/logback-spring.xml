<?xml version="1.0" encoding="UTF-8"?>
<!-- §13：事件文本与异常只能经 %pbmsg/%pbex 输出，两个 appender 共用同一条 PB_PATTERN。 -->
<configuration>
    <!-- class 而非 converterClass：后者在 logback 1.5 已废弃，留着它每次启动先刷两行 WARN，
         正好把"容器起来没有"这个判据搅浑。 -->
    <conversionRule conversionWord="pbmsg"
        class="dev.pushbox.server.log.MaskingMessageConverter"/>
    <conversionRule conversionWord="pbex"
        class="dev.pushbox.server.log.MaskingThrowableConverter"/>

    <property name="PB_PATTERN"
        value="%d{HH:mm:ss.SSS} %-5level %logger{20} [%X{msg_id:-}] - %pbmsg%pbex%n"/>
    <!-- 目录必须来自环境：compose 把它指到 /app/logs（named volume 挂在那儿），本机直跑落 ./logs。
         写死相对路径等于跟着工作目录漂，容器的 WORKDIR 一改就没人在那本文件里找日志。 -->
    <property name="PB_LOG_HOME" value="${PB_LOG_DIR:-logs}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${PB_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <springProfile name="!dev">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${PB_LOG_HOME}/pushbox-server.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${PB_LOG_HOME}/pushbox-server-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <!-- maxFileSize 不写就用默认 10MB：一次抓取风暴能把当天日志切成几十个文件，
                     排查时要跨文件拼时间线。64MB 让一天通常就是一两本。 -->
                <maxFileSize>64MB</maxFileSize>
                <maxHistory>14</maxHistory>
                <totalSizeCap>2GB</totalSizeCap>
            </rollingPolicy>
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>${PB_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
    </springProfile>

    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="dev.pushbox" level="DEBUG"/>
    </springProfile>

    <!-- prod 是 INFO 而不是 WARN：加密模式生效与否、限流参数、sweep 节奏这些判据全是 INFO 行，
         容器里只剩 WARN 等于出事时没有现场。隐私靠 converter 兜，与级别无关。 -->
    <springProfile name="!dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>
</configuration>
