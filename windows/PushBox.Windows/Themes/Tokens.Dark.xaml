<!-- §9.1 的深色 token：整站反色、不碰纯黑（bg.page 用 #111111 而不是 #000000）。
     键名必须与 Tokens.xaml 完全一致——ThemeManager 只是把这两份的先后顺序换一下。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色模式：避免纯黑，使用深灰层级 -->
    <SolidColorBrush x:Key="Bg.Page" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Bg.Elevated" Color="#242424" />
    <SolidColorBrush x:Key="Bg.Bubble.In" Color="#0D3D28" />

    <!-- 文字颜色（保证对比度） -->
    <SolidColorBrush x:Key="Fg.Primary" Color="#E0E0E0" />
    <SolidColorBrush x:Key="Fg.Secondary" Color="#9E9E9E" />

    <!-- 品牌主色深色变体 -->
    <SolidColorBrush x:Key="Accent" Color="#0A8F4A" />

    <!-- 语义色深色模式 -->
    <SolidColorBrush x:Key="Badge.Unread" Color="#FF4D4F" />
    <SolidColorBrush x:Key="Divider" Color="#333333" />
    <SolidColorBrush x:Key="State.Offline" Color="#FFA726" />
    <SolidColorBrush x:Key="Level.Error" Color="#FF5252" />
    <SolidColorBrush x:Key="Level.Warning" Color="#FFB74D" />
    <SolidColorBrush x:Key="Level.Info" Color="#9E9E9E" />

    <!-- §7.4 的命中高亮：Android 那边两端同一个值（#1A73E8 + 加粗），深浅色都不换 -->
    <SolidColorBrush x:Key="Level.Highlight" Color="#1A73E8" />

    <!-- §9.2 的字体层级系统（深色主题复用浅色定义的样式，字体族与字号不随主题变化） -->
    <!-- 基础字体族 -->
    <FontFamily x:Key="Font.UI">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Code">Consolas, Microsoft YaHei UI</FontFamily>

    <!-- H1: 20px / Bold -->
    <Style x:Key="Text.H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- H2: 18px / Bold -->
    <Style x:Key="Text.H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- H3: 16px / SemiBold (会话名) -->
    <Style x:Key="Text.H3" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- Body: 15px / Normal (消息正文) -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="23" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- Small: 13px / Normal (摘要、副文本) -->
    <Style x:Key="Text.Small" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- Label: 12px / Normal (时间戳、角标、提示) -->
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    </Style>

    <!-- Code: 13px / Monospace (恢复码、设备 ID、curl 命令) -->
    <Style x:Key="Text.Code" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Code}" />
    </Style>

</ResourceDictionary>
