# 本机开发联调配置模板（使用本地文件系统存储，无需 S3/MinIO）
# 用法：cp deploy/env/local.env.example deploy/env/local.env
#      然后修改下面的占位值为实际值
#
# 每一项都带 export：这个文件是被 `source` 进当前 shell 的，没有 export 只会得到一组
# bash 变量，而 java 进程与 `@EnabledIfEnvironmentVariable` 那批用例读的是真正的进程
# 环境——现象是服务端报"PB_DB_PASSWORD 没配"、集成测试整批静默跳过，两个都像别处的 bug。
#
# 先看清"dev 真读了哪几个"：application-dev.yml 里只有下面带 ◆ 的键是占位符，其余都写死。
# 把没读者的键当成开关去改，是这一份模板最容易踩的空转——改完没变化，又去怀疑代码。
#   ◆ PB_DB_PASSWORD  ◆ PB_STORAGE_TYPE  ◆ PB_STORAGE_LOCAL_PATH
#   ◆ PB_S3_ENDPOINT / PB_S3_ACCESS_KEY / PB_S3_SECRET_KEY / PB_S3_BUCKET / PB_S3_MASTER_KEY / PB_S3_MASTER_PASSPHRASE
#   ◆ PB_ADMIN_SECRET
# dev 写死不读：库地址与库用户（127.0.0.1:3306/pushbox、pushbox）、object-encrypt（none）、
# admin.jwt-secret、server.port（要换端口用 --server.port=8081，别加 PB_SERVER_PORT）。

# ---- 数据库（本机 MySQL）----
# PB_DB_URL / PB_DB_USERNAME 是给"同一份 local.env 还要起 prod/compose"的人准备的，dev 不读。
# 本机联调要换库或换用户，改的是 application-dev.yml 那一行（它入库，别把口令写进去）。
export PB_DB_URL=jdbc:mysql://127.0.0.1:3306/pushbox?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
export PB_DB_USERNAME=root
# 这是 dev 唯一硬必填的一项；profile 是 pushbox 用户（不是 root），口令按那个用户填
export PB_DB_PASSWORD=<pushbox 用户的口令>

# ---- 存储后端：本地文件系统（dev 默认，不需要任何桶）---- ◆
export PB_STORAGE_TYPE=local
export PB_STORAGE_LOCAL_PATH=./data/media

# ---- 对象加密 ----
# dev 的 application-dev.yml 把 object-encrypt 写死成 none，改这一行不会生效；
# 要验 sse-c 请在 prod/compose 口径下跑，或临时用 --pb.s3.object-encrypt=sse-c 起进程。
export PB_S3_OBJECT_ENCRYPT=none
# sse-c 的 KEK 二选一（两个都配会拒绝启动）：
# export PB_S3_MASTER_KEY=<base64 的 32 字节；用了就不能换>
# export PB_S3_MASTER_PASSPHRASE=<至少 12 个字符的口令；Argon2id 派生，盐/KCV 存 app_state，用了就不能换>

# ---- Web 管理台 ----
export PB_ADMIN_SECRET=dev-admin-secret-change-me         # ◆ 留空即整个管理台 403 禁用
export PB_ADMIN_JWT_SECRET=dev-jwt-secret-must-be-different-and-at-least-32-bytes-long!!   # dev 不读（yml 写死一份仅本地的值）

# ---- 要走对象存储才取消注释这三项，并把上面的 PB_STORAGE_TYPE 改成 s3 ----
# export PB_S3_ENDPOINT=http://127.0.0.1:9000
# export PB_S3_ACCESS_KEY=<你的 Access Key>
# export PB_S3_SECRET_KEY=<你的 Secret Key>

# ---- 只在 prod/compose 口径下有意义（dev 不读）----
# export PB_SERVER_PORT=7404
# export PB_HTTP_PORT=80
# export PB_CADDY_HOST=localhost
