# 本机开发联调配置模板（使用本地文件系统存储，无需 S3/MinIO）
# 用法：cp deploy/env/local.env.example deploy/env/local.env
#      然后修改下面的占位值为实际值

# ---- 数据库（本机 MySQL）----
PB_DB_URL=jdbc:mysql://127.0.0.1:3306/pushbox?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
PB_DB_USERNAME=root
PB_DB_PASSWORD=<你的MySQL root密码>

# ---- 存储后端：本地文件系统 ----
PB_STORAGE_TYPE=local
PB_STORAGE_LOCAL_PATH=./data/media

# ---- 对象加密（可选：none 或 sse-c）----
# none：明文落盘，适合开发调试
# sse-c：AES-256-GCM 加密，需要主钥
PB_S3_OBJECT_ENCRYPT=none
# PB_S3_MASTER_KEY=<base64 的 32 字节，仅当 object-encrypt=sse-c 时必填>

# ---- Web 管理台（开发环境可用简单口令）----
PB_ADMIN_SECRET=dev-admin-secret-change-me
PB_ADMIN_JWT_SECRET=dev-jwt-secret-must-be-different-and-at-least-32-bytes-long!!

# ---- 其他可选配置 ----
# PB_SERVER_PORT=7404
# PB_HTTP_PORT=80
# PB_CADDY_HOST=localhost
