# WSL/Docker 测试环境的示例配置：复制成 deploy/wsl-test.env 再按本机情况填值。

# 本文件入库、真实那份不入库（.gitignore 里排掉了），原因与 prod.env.example 一样：
# wsl-test.env 里那几个口令位哪怕写的是测试值，进了公开仓库就等于对全世界公开"这套部署的口令长什么样"，
# 而 copy-paste 是双向的——有人会把它当模板直接用在真机上。

# 复制并填值（这一行必须带 #：compose 的 --env-file 会解析不出裸 shell 命令，
# 报 "unexpected character \"/\" in variable name"，而报错里看不出是注释掉了还是没注释）：
#   cp deploy/wsl-test.env.example deploy/wsl-test.env

# WSL Docker 测试环境配置 - 完整独立部署（拓扑 B）
# 包含 MySQL + RustFS + PushBox Server + Caddy

# 数据库配置（使用 Docker Compose 中的 mysql 服务）
PB_DB_URL=jdbc:mysql://mysql:3306/pushbox?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
PB_DB_USERNAME=pushbox
PB_DB_PASSWORD=changeme-db-password
MYSQL_ROOT_PASSWORD=changeme-root-password

# S3 配置（使用 Docker Compose 中的 rustfs 服务）
PB_S3_ENDPOINT=http://rustfs:9000
PB_S3_REGION=us-east-1
PB_S3_BUCKET=pushbox
PB_S3_ACCESS_KEY=changeme-s3-access-key
PB_S3_SECRET_KEY=changeme-s3-secret-key
PB_S3_PATH_STYLE=true

# 存储类型：s3（使用 RustFS）
PB_STORAGE_TYPE=s3

# 对象加密：none（测试环境）
PB_S3_OBJECT_ENCRYPT=none
PB_S3_MASTER_KEY=
# 随机主钥与口令二选一；这一套测试栈走 none，两个都留空
PB_S3_MASTER_PASSPHRASE=
PB_ALLOW_PLAINTEXT_MEDIA=true

# 管理台配置
PB_ADMIN_SECRET=changeme-admin-secret
PB_ADMIN_JWT_SECRET=changeme-admin-jwt-secret-0123456789

# 端口配置
PB_SERVER_PORT=7404
PB_HTTP_PORT=80
PB_CADDY_HOST=localhost

# 安全配置
PB_SECURITY_INTERNAL_CIDRS=172.16.0.0/12,127.0.0.0/8

# 监控配置（可选）
GRAFANA_ADMIN_PASSWORD=changeme-grafana-admin
