target/
build/
.gradle/
**/generated/
*.class
*.jar
!.mvn/wrapper/*.jar
!android/gradle/wrapper/gradle-wrapper.jar

# 本机凭据与联调配置，绝不入库
infra/env/local.env
infra/env/*.env
# WSL 联调那套也是同一性质：值本身是测试值，但进了公开仓就等于把"这套部署的口令位长什么样"发出去，
# 而且 copy-paste 是双向的——总有人把测试 env 直接当模板用在真机上。入库的是 .example。
infra/wsl-test.env
# 但上面那两条会顺手盖掉模板，模板是必须入库的
!infra/env/*.env.example
!infra/wsl-test.env.example
application-local.yml
.env
local.properties

# 签名密钥与证书只活在本机或 CI 的临时文件里；连文件名都不进仓库
*.jks
*.keystore
*.p12
*.pvk
keystore.properties
android/dev/

# compose 里 mysql/rustfs/prometheus/grafana 的 bind mount 宿主目录。
# pushbox-server 的日志用的是 named volume，不落在这里。
infra/data/

# 本地文件系统存储数据（安装页里没勾「改用对象存储」时图片落这里）
infra/media/

.idea/
*.iml
.DS_Store
node_modules/

# Windows 客户端（P3）W15：自包含发布物与安装包，各上百 MB，只在本机 build-installer.sh 现编
windows/installer/publish/
windows/installer/Output/

# Windows 编译产物
windows/**/bin/
windows/**/obj/
windows/**/*.user
windows/**/*.suo
windows/bin/

# CI/CD 工作流配置：v1.1.0 起入库（.github/workflows/ci.yml 是 PR 门禁，不入库就等于门禁不存在）。

# 临时日志与调试产物
*.log
*.tmp
# Kotlin 编译缓存与错误报告（errors/ 与 sessions/ 都是每次构建重生的）
android/.kotlin/

# 运行期数据目录：安装页写出的 config/pushbox.json（**里面有库口令、Access/Secret Key、
# 加密口令与主钥，全是明文**）、本地存储的图片、日志。落在哪取决于工作目录——
# 直接跑 jar 是仓库根，`mvn -pl server test` 是 server/，所以两个路径都要挡。
# 图片那层长成 data/media/media/<msg_id>/0.bin：多出来的一层是对象键自带的 `media/` 前缀，不是配错了目录。
/data/
/server/data/

# 产物层：release 脚本把各端编译结果收进这里（jar / apk / exe），仓库只留 .gitkeep
/output/*
!/output/.gitkeep

# 真机截图与验收现场，每次跑都换一批名字；留本机当证据，不入库
/.tmp-shot/
# 容器 entrypoint 的本机跑法（按 BuildKit 规则还原脚本 + 25 条场景矩阵），同样是每次重生的现场
/.tmp-deploy/
/verify/
# ci.yml 的 windows job 用它做 trx 计数闸的输入，本机复跑同一命令就会生成
windows/TestResults/
